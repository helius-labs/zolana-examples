# Helius devnet RPC key.
API_KEY=YOUR_KEY

# Optional overrides. Omit them to use the default devnet services.
# For a local stack, toggle the `localnet:` lines in src/lib.ts instead.
# ZOLANA_ENDPOINT=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# ZOLANA_INDEXER_URL=https://d21d98xh5lgv3b.cloudfront.net
# ZOLANA_PROVER_URL=https://d1unet9hn0mci0.cloudfront.net

# Fee payer (Solana CLI wallet by default).
ZOLANA_PAYER_KEYPAIR=~/.config/solana/id.json
