# Optional hosted Zolana RPC. Omit it to use the SDK's localnet defaults.
# Hosted indexer/prover URLs must be HTTPS unless they are loopback HTTP.
ZOLANA_ENDPOINT=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
ZOLANA_INDEXER_URL=http://zolnet-devnet-1779374825.eu-north-1.elb.amazonaws.com
ZOLANA_PROVER_URL=http://zolnet-devnet-1779374825.eu-north-1.elb.amazonaws.com:3001

# Fee payer (Solana CLI wallet by default).
ZOLANA_PAYER_KEYPAIR=~/.config/solana/id.json
