# Helius API key for Solana RPC, the indexer, and the attested prover.
API_KEY=YOUR_KEY

# Optional endpoint. Omit it to use devnet with API_KEY above.
# ZOLANA_ENDPOINT=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# ZOLANA_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Local stack overrides.
# ZOLANA_ENDPOINT=http://127.0.0.1:8899
# ZOLANA_INDEXER_URL=http://127.0.0.1:8784
# ZOLANA_PROVER_URL=http://127.0.0.1:3001

# Fee payer (Solana CLI wallet by default).
ZOLANA_PAYER_KEYPAIR=~/.config/solana/id.json
