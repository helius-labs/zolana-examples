# Helius devnet RPC key.
API_KEY=YOUR_KEY

# Optional overrides. Omit them to use Helius RPC plus the Photon/prover ALB.
# For a local stack, uncomment `return Object.freeze({});` in src/lib.ts, or set:
# ZOLANA_ENDPOINT=http://127.0.0.1:8899
# ZOLANA_INDEXER_URL=http://127.0.0.1:8784
# ZOLANA_PROVER_URL=http://127.0.0.1:3001

# Fee payer (Solana CLI wallet by default).
ZOLANA_PAYER_KEYPAIR=~/.config/solana/id.json
