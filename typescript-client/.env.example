# Optional hosted Zolana gateway. Omit it to use the SDK's localnet defaults.
ZOLANA_ENDPOINT=

# Fee payer (Solana CLI wallet by default).
ZOLANA_PAYER_KEYPAIR=~/.config/solana/id.json

# A Solana account whose private wallet is registered on the selected network.
ZOLANA_RECIPIENT=DNRJcGsGR6SGEYuNAaRtbZ8a86snwVcH5CJh1VcSLxx
