{
  "name": "privy-node-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "oxfmt --check . && tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "validate:devnet": "tsx validation/validate-devnet.ts",
    "validate:protocol": "tsx validation/validate-protocol.ts"
  },
  "dependencies": {
    "@heliuslabs/zolana": "0.7.0-alpha",
    "@privy-io/react-auth": "3.51.0",
    "@solana-program/compute-budget": "0.20.0",
    "@solana-program/memo": "0.16.0",
    "@solana-program/system": "0.14.1",
    "@solana/kit": "^8.3.0",
    "dotenv": "^17.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "oxfmt": "^0.75.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=24"
  }
}
