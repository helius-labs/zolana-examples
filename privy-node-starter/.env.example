# Public Privy App ID. Enable Solana embedded wallets and localhost in Privy.
VITE_PRIVY_APP_ID=

# Used by the local Vite proxy and Node validation, never exposed in client code.
API_KEY=

# Only needed for automated validation with Privy server wallets.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
