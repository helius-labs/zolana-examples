# Your Helius API key. Every wallet the server creates belongs to its project.
HELIUS_API_KEY=your_api_key_here

# `pnpm test:devnet`: funded devnet-only Solana JSON keypair (64 bytes).
# Put the file here, or set an absolute path to an existing devnet payer.
# The keypair and all run results stay inside gitignored .data/.
DEVNET_PAYER_KEYPAIR_PATH=.data/devnet-payer.json

# Optional.
# PORT=3300
# DATA_DIR=.data
