# Public browser Helius key; the project must support embedded wallets.
VITE_API_KEY=YOUR_KEY

# Optional devnet RPC override. TVC and private sync use the fixed Vite proxy.
# VITE_ZOLANA_ENDPOINT=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# Never add Turnkey operator keys or app secrets to VITE_ variables.
